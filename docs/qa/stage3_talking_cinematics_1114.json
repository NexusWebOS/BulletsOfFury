      "part": "hq",
      "expectedBeats": [
        {
          "id": "B301",
          "who": "COLE",
          "text": "All right. We're home. What did we bring back?",
          "duration": 3.84,
          "mode": null
        },
        {
          "id": "POST3-02",
          "who": "DECKER",
          "text": "The relay's recorder. Every machine heard the same voice.",
          "duration": 4.445,
          "mode": null
        },
        {
          "id": "POST3-03",
          "who": "COLE",
          "text": "Whose?",
          "duration": 2.05,
          "mode": null
        },
        {
          "id": "POST3-04",
          "who": "DECKER",
          "text": "I don't know yet. There's a launch record in here. Same signal. It came from the airfield east of us.",
          "duration": 6.99,
          "mode": null
        },
        {
          "id": "POST3-05",
          "who": "LIZZIE",
          "text": "So we go to the airfield.",
          "duration": 2.87,
          "mode": null
        },
        {
          "id": "POST3-06",
          "who": "DECKER",
          "text": "I also need its backup power cell. Without it, we don't get above the atmosphere.",
          "duration": 5.765000000000001,
          "mode": null
        },
        {
          "id": "POST3-07",
          "who": "AXEL",
          "text": "I'll take point.",
          "duration": 2.21,
          "mode": null
        },
        {
          "id": "POST3-08",
          "who": "FREEZER",
          "text": "Then I'll watch your tail.",
          "duration": 2.5799999999999996,
          "mode": null
        },
        {
          "id": "POST3-09",
          "who": "MAVERICK",
          "text": "Try to leave something for the rest of us.",
          "duration": 3.7600000000000002,
          "mode": null
        },
        {
          "id": "POST3-10",
          "who": "JUGGERNAUT",
          "text": "Everybody gets home. That's the deal.",
          "duration": 3.185,
          "mode": null
        },
        {
          "id": "POST3-11",
          "who": "COLE",
          "text": "That's the deal.",
          "duration": 2.21,
          "mode": null
        },
        {
          "id": "POST3-12",
          "who": "DECKER",
          "text": "The ice core's safe. I'll see what we can use before you leave.",
          "duration": 4.93,
          "mode": null
        },
        {
          "id": "POST3-13",
          "who": "CAPTION",
          "text": "A few minutes later. Decker's workshop.",
          "duration": 3.455,
          "mode": null
        },
        {
          "id": "POST3-14",
          "who": "COLE",
          "text": "You moved the coil.",
          "duration": 2.355,
          "mode": null
        },
        {
          "id": "POST3-15",
          "who": "DECKER",
          "text": "Thought you'd spot that. Watch this.",
          "duration": 3.13,
          "mode": null
        },
        {
          "id": "POST3-16",
          "who": "SYSTEM",
          "text": "",
          "duration": 2.66,
          "mode": null
        },
        {
          "id": "POST3-17",
          "who": "COLE",
          "text": "That's your Photon Cannon?",
          "duration": 2.7399999999999998,
          "mode": null
        },
        {
          "id": "POST3-18",
          "who": "DECKER",
          "text": "Ours. You wound half the coils.",
          "duration": 2.855,
          "mode": null
        },
        {
          "id": "POST3-19",
          "who": "COLE",
          "text": "Come here, you lunatic.",
          "duration": 2.5749999999999997,
          "mode": null
        },
        {
          "id": "POST3-20",
          "who": "DECKER",
          "text": "Easy! Still need those ribs.",
          "duration": 2.85,
          "mode": null
        },
        {
          "id": "POST3-21",
          "who": "COLE",
          "text": "When can I fly it?",
          "duration": 2.58,
          "mode": null
        },
        {
          "id": "POST3-22",
          "who": "DECKER",
          "text": "When it stops melting the stand. Bring me that power cell.",
          "duration": 4.34,
          "mode": null
        },
        {
          "id": "POST3-23",
          "who": "COLE",
          "text": "You've got it.",
          "duration": 2.05,
          "mode": null
        }
      ],
