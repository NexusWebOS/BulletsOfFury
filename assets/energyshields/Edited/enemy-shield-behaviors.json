      "impact_animation": "cyan"
    },
    {
      "id": "crimson-plasma-field",
      "type": "force_field",
      "map": "../crimson-plasma-field/crimson-plasma-field-map.json",
      "impact_animation": "crimson"
    },
    {
      "id": "violet-phase-shell",
      "type": "force_field",
      "map": "../violet-phase-shell/violet-phase-shell-map.json",
      "impact_animation": "violet"
    },
    {
      "id": "forward-hex-deflector",
      "type": "directional_deflector",
      "map": "../forward-hex-deflector/forward-hex-deflector-map.json",
      "impact_animation": "cyan"
    },
    {
      "id": "gold-kinetic-mirror",
      "type": "directional_deflector",
      "map": "../gold-kinetic-mirror/gold-kinetic-mirror-map.json",
      "impact_animation": "green_gold"
    },
    {
      "id": "alien-prism-deflector",
