      "expectedBeats": [
        {
          "id": "B201",
          "who": "COLE",
          "text": "Come on, Decker. Pick up.",
          "duration": 2.685,
          "c16": true
        },
        {
          "id": "POST2-02",
          "who": "DECKER",
          "text": "There you are! I thought we'd lost you.",
          "duration": 3.3,
          "c16": true
        },
        {
          "id": "POST2-03",
          "who": "COLE",
          "text": "You can yell at me when I'm home. What is this thing?",
          "duration": 4.640000000000001,
          "c16": true
        },
        {
          "id": "POST2-04",
          "who": "DECKER",
          "text": "A service port. Plug in the recorder. Keep it off the network.",
          "duration": 4.720000000000001,
          "c16": true
        },
        {
          "id": "POST2-05",
          "who": "DECKER",
          "text": "Got it. The next relay's in the ice field.",
          "duration": 3.6,
          "c16": true
        },
        {
          "id": "POST2-06",
          "who": "DECKER",
          "text": "I've got a fire rig ready. Those ice tanks won't like it.",
          "duration": 4.48,
          "c16": true
        },
        {
          "id": "POST2-07",
          "who": "COLE",
          "text": "Good. I could use something on my side.",
          "duration": 3.3,
          "c16": true
        },
        {
          "id": "POST2-08",
          "who": "DECKER",
          "text": "Get out of there. The ground is moving.",
          "duration": 3.46,
          "c16": true
        }
      ],
