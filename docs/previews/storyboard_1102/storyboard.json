  {
   "id": "stage7-approach",
   "title": "Stage 7 — river approach",
   "group": "Campaign",
   "kind": "director",
   "beats": [
    {
     "who": "DECKER",
     "text": "The alien signal is below the city. Take us down along the river.",
     "art": "cin_story_city_descent",
     "duration": 5.2,
     "frame": "frames/stage7-approach_00.jpg"
    },
    {
     "who": "SHIP SYSTEM",
     "text": "Low altitude confirmed. Following the river toward the iron bridge.",
     "art": "cin_story_river_high",
     "duration": 5.2,
     "frame": "frames/stage7-approach_01.jpg"
    },
    {
     "who": "COLE",
     "text": "Bridge ahead. Staying low. The signal is on the far bank.",
     "art": "cin_story_river_bridge",
     "duration": 5.2,
     "frame": "frames/stage7-approach_02.jpg"
    },
    {
     "who": "DECKER",
     "text": "That sewer access is the source. We never searched underground.",
