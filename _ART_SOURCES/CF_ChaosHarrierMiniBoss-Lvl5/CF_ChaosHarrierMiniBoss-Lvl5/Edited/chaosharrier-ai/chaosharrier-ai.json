  "states": {
    "spawn_warp_in": {
      "duration_ms": 1200,
      "enter": [
        "set_visible_false",
        "set_collision_false",
        "play_warp_in"
      ],
      "timeline": [
        {
          "at_ms": 600,
          "event": "set_visible_true"
        },
        {
          "at_ms": 1050,
          "event": "set_collision_true"
        }
      ],
      "next": "track"
    },
    "track": {
      "duration_ms_range": [
        520,
        900
      ],
      "actions": [
        "update_phase",
        "follow_phase_movement",
        "select_weighted_attack"
      ],
      "next": "selected_attack"
    },
    "selected_attack": {
      "dispatch": {
        "alternating_laser_burst": "attack_laser_burst",
        "missile_fan": "attack_missiles",
        "twin_laser_salvo": "attack_twin_lasers",
        "giant_nose_laser": "attack_nose_laser",
        "warp_then_laser_burst": "queue_warp_laser_burst",
        "warp_then_twin_lasers": "queue_warp_twin_lasers"
      }
    },
    "attack_missiles": {
      "enter": [
        "set_missile_bays_open_true",
        "hold_ship_attack_open"
      ],
      "run_pattern": "missile_fan",
      "exit": [
        "set_missile_bays_open_false",
        "release_ship_attack_open"
      ],
      "next": "recover"
    },
    "warp_out": {
      "duration_ms": 600,
      "enter": [
        "choose_safe_anchor",
        "play_warp_out"
      ],
      "timeline": [
        {
          "at_ms": 225,
          "event": "set_collision_false"
        },
        {
          "at_ms": 300,
          "event": "set_visible_false"
        },
        {
          "at_ms": 375,
          "event": "move_to_selected_anchor"
        }
      ],
      "next": "warp_in"
    },
    "warp_in": {
      "duration_ms": 600,
      "enter": [
        "play_warp_in"
      ],
      "timeline": [
        {
          "at_ms": 300,
          "event": "set_visible_true"
        },
        {
          "at_ms": 525,
          "event": "set_collision_true"
        }
      ],
      "next": "queued_attack_or_recover"
    },
    "queued_attack_or_recover": {
      "dispatch_blackboard": {
        "key": "queued_attack_after_warp",
        "null": "recover",
        "attack_laser_burst": "attack_laser_burst",
        "attack_twin_lasers": "attack_twin_lasers"
      },
      "exit": [
        {
          "set_blackboard": {
            "queued_attack_after_warp": null
          }
        }
      ]
    },
    "recover": {
      "duration_ms_range": [
        480,
        820
      ],
      "actions": [
        "follow_phase_movement",
        "increment_attack_count"
      ],
      "next": "track"
    },
    "critical_enter": {
      "enter": [
        "set_phase_3",
        "set_ship_critical",
        "force_warp_to_safe_anchor"
      ],
      "next": "track"
    },
    "dead": {
      "enter": [
        "set_collision_false",
        "cancel_all_attacks",
        "emit_death_sequence_request"
      ],
      "terminal": true
    },
    "attack_laser_burst": {
      "run_pattern": "alternating_laser_burst",
      "next": "recover"
    },
    "attack_twin_lasers": {
      "run_pattern": "twin_laser_salvo",
      "next": "recover"
    },
    "attack_nose_laser": {
      "enter": [
        "stop_movement",
        "clear_pending_missile_spawns"
      ],
      "run_pattern": "giant_nose_laser",
      "exit": [
        "unlock_aim",
        "resume_movement"
      ],
      "next": "recover"
    },
    "queue_warp_laser_burst": {
      "enter": [
        {
          "set_blackboard": {
            "queued_attack_after_warp": "attack_laser_burst"
          }
        }
      ],
      "next": "warp_out"
    },
    "queue_warp_twin_lasers": {
      "enter": [
        {
          "set_blackboard": {
            "queued_attack_after_warp": "attack_twin_lasers"
          }
        }
      ],
      "next": "warp_out"
    }
  },
  "global_transitions": [
    {
      "condition": "health_percent <= 0",
      "to": "dead",
      "priority": 100
    },
    {
      "condition": "health_percent <= 35 and phase < 3",
      "to": "critical_enter",
      "priority": 80
    },
    {
      "condition": "health_percent <= 70 and phase < 2",
      "actions": [
        "set_phase_2"
      ],
      "priority": 70
    }
  ],
  "anti_repeat": {
    "maximum_same_attack_in_row": 1,
    "giant_nose_laser_cannot_repeat": true,
    "warp_cannot_repeat_without_attack_between": true
  },
  "readability_rules": [
    "Never overlap giant-nose-laser telegraph with missile launch.",
    "Never spawn a projectile while the ship is invisible.",
    "Missile spawns require attack_open and one of the two visible red bay hardpoints.",
    "Side pod weapons use laser projectiles only.",
    "The giant beam and dedicated muzzle flash share the nose_laser hardpoint.",
    "The relocation occurs only while the peak warp frame covers the ship.",
    "Keep one player escape lane at least 64 pixels wide.",
    "Idle animation holds one hull frame; internal lights animate as a registered overlay."
  ]
}
