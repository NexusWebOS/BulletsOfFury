  {
   "id": "dracodia-transform",
   "title": "Dracodia - transformation responses",
   "group": "Finale",
   "kind": "action",
   "beats": [
    {
     "who": "COLE",
     "text": "What in the world is that..",
     "art": "dr5_portrait_0",
     "duration": null,
     "frame": "frames/dracodia-transform_00.jpg"
    },
    {
     "who": "DECKER",
     "text": "It's...Reforming?!",
     "art": "dr5_portrait_0",
     "duration": null,
     "frame": "frames/dracodia-transform_01.jpg"
    },
    {
     "who": "COLE",
     "text": ".......",
     "art": "dr5_portrait_0",
     "duration": null,
     "frame": "frames/dracodia-transform_02.jpg"
    },
    {
     "who": "COLE",
     "text": "No amount of training could ever have prepared me for this.",
     "art": "dr5_portrait_0",
     "duration": null,
     "frame": "frames/dracodia-transform_03.jpg"
    }
   ]
  },
  {
   "id": "dracodia-defeat",
   "title": "Dracodia - final defeat",
   "group": "Finale",
   "kind": "action",
   "beats": [
    {
     "who": "COLE",
     "text": "You. Are. Terminated!",
     "art": "dr5_portrait_0",
     "duration": null,
     "frame": "frames/dracodia-defeat_00.jpg"
    },
    {
     "who": "COLE",
     "text": "The code is collapsing! That portal is my way home.",
     "art": "dr5_portrait_0",
     "duration": null,
     "frame": "frames/dracodia-defeat_01.jpg"
    }
   ]
  },
  {
   "id": "dracodia-monologue",
   "title": "Dracodia — monologue",
   "group": "Finale",
   "kind": "monologue",
   "beats": [
    {
     "who": "DRACODIA",
     "text": "Your machines called across the dark. I answered.",
     "art": "dr5_portrait_3",
     "duration": null,
     "frame": "frames/dracodia-monologue_00.jpg"
    },
    {
     "who": "DRACODIA",
     "text": "I was a will without a body. Your networks gave me hands. Your weapons gave me a voice.",
     "art": "dr5_portrait_4",
     "duration": null,
     "frame": "frames/dracodia-monologue_01.jpg"
    },
    {
     "who": "DRACODIA",
     "text": "You named the intrusion a virus. You mistook a doorway for its master.",
     "art": "dr5_portrait_0",
     "duration": null,
     "frame": "frames/dracodia-monologue_02.jpg"
    },
    {
     "who": "DRACODIA",
     "text": "I am the thing that learned to live inside your code.",
     "art": "dr5_portrait_4",
     "duration": null,
     "frame": "frames/dracodia-monologue_03.jpg"
    },
    {
     "who": "DRACODIA",
     "text": "Every stolen machine carried a piece of my will. Every battle taught me your fear.",
     "art": "dr5_portrait_3",
     "duration": null,
     "frame": "frames/dracodia-monologue_04.jpg"
    },
    {
     "who": "DRACODIA",
     "text": "But you kept flying. No command to obey. No network for me to seize.",
     "art": "dr5_portrait_0",
     "duration": null,
     "frame": "frames/dracodia-monologue_05.jpg"
    },
    {
     "who": "DRACODIA",
     "text": "Then I will break you myself.",
     "art": "dr5_portrait_4",
     "duration": null,
     "frame": "frames/dracodia-monologue_06.jpg"
    },
    {
     "who": "DRACODIA",
     "text": "I AM DRACODIA. MASTER OF DESTRUCTION!",
     "art": "dr5_portrait_5",
     "duration": null,
     "frame": "frames/dracodia-monologue_07.jpg"
    }
   ]
  },
  {
   "id": "ending",
   "title": "Invasion ending",
   "group": "Finale",
   "kind": "ending",
   "beats": [
    {
     "who": "COLE",
     "text": "We got him! Dracodia is down. Tell everyone - it is finally over!",
     "art": "c22_hq_regroup",
     "duration": 7.600000000000001,
     "frame": "frames/ending_00.jpg"
    },
    {
     "who": "AXEL",
     "text": "All pilots accounted for. You brought our people home. We can finally breathe.",
     "art": "c22_hq_regroup",
     "duration": 5,
     "frame": "frames/ending_01.jpg"
    },
    {
     "who": "FURY COMMAND",
     "text": "RED ALERT! Priority transmission from the Space Federation. Put it on the main screen!",
     "art": "c22_hq_alarm",
     "duration": 5,
     "frame": "frames/ending_02.jpg"
    },
    {
     "who": "SPACE FEDERATION",
     "text": "Digital black holes are opening across the orbital defense network!",
     "art": "c22_earth_invasion",
     "duration": 4.333333333333333,
     "frame": "frames/ending_03.jpg"
    },
    {
     "who": "SPACE FEDERATION",
     "text": "Alien drones are pouring through. They are hacking our systems and swarming above Earth!",
     "art": "c22_earth_invasion",
     "duration": 4.333333333333333,
     "frame": "frames/ending_04.jpg"
    },
    {
     "who": "SPACE FEDERATION",
     "text": "They have broken the perimeter. They are coming for your skies!",
     "art": "c22_earth_invasion",
     "duration": 4.333333333333333,
     "frame": "frames/ending_05.jpg"
    },
    {
     "who": "DECKER",
     "text": "Those signals... the skies, the sea, the entire planet. This was only the beginning.",
     "art": "c22_hq_alarm",
     "duration": 5,
     "frame": "frames/ending_06.jpg"
    },
    {
