        "expectedBeats": [
          {
            "id": "B501",
            "who": "COLE",
            "text": "HQ, open the doors. We're coming home.",
            "duration": 3.4,
            "kind": "travel",
            "upgrade": null
          },
          {
            "id": "POST5-02",
            "who": "JUGGERNAUT",
            "text": "Hey. We all made it, right?",
            "duration": 2.87,
            "kind": "dialogue",
            "upgrade": null
          },
          {
            "id": "POST5-03",
            "who": "COLE",
            "text": "We did. Give me a hand with this thing.",
            "duration": 3.6,
            "kind": "dialogue",
            "upgrade": null
          },
          {
            "id": "B503",
            "who": "DECKER",
            "text": "You actually brought the gun back.",
            "duration": 3.18,
            "kind": "insert",
            "upgrade": null
          },
          {
            "id": "POST5-05",
            "who": "COLE",
            "text": "Nearly killed us. Figured it owed us something.",
            "duration": 3.895,
            "kind": "dialogue",
            "upgrade": null
          },
          {
            "id": "POST5-06",
            "who": "JUGGERNAUT",
            "text": "Can I have it?",
            "duration": 2.29,
            "kind": "dialogue",
            "upgrade": null
          },
          {
            "id": "POST5-07",
            "who": "DECKER",
            "text": "No.",
            "duration": 2.05,
            "kind": "dialogue",
            "upgrade": null
          },
          {
            "id": "POST5-08",
            "who": "JUGGERNAUT",
            "text": "Had to ask.",
            "duration": 2.05,
            "kind": "dialogue",
            "upgrade": null
          },
          {
            "id": "POST5-09",
            "who": "CAPTION",
            "text": "Later that night.",
            "duration": 2.7600000000000002,
            "kind": "insert",
            "upgrade": null
          },
          {
            "id": "POST5-10",
            "who": "DECKER",
            "text": "It works. I can fit the squad with these.",
            "duration": 3.7600000000000002,
            "kind": "dialogue",
            "upgrade": 5
          },
          {
            "id": "POST5-11",
            "who": "COLE",
            "text": "Keep my rig as it is. Get everybody else ready.",
            "duration": 3.89,
            "kind": "dialogue",
            "upgrade": null
          },
          {
            "id": "POST5-12",
            "who": "JUGGERNAUT",
            "text": "Now that's heavy metal.",
