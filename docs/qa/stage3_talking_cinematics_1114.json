      "expectedBeats": [
        {
          "id": "SL2-01",
          "who": "COLE",
          "text": "Decker, what am I looking at?",
          "duration": 4.76,
          "mode": "radio"
        },
        {
          "id": "SL2-02",
          "who": "DECKER",
          "text": "A service data-link. It's restoring power to our internal relay systems.",
          "duration": 5.11,
          "mode": "radio"
        },
        {
          "id": "SL2-03",
          "who": "DECKER",
          "text": "Think of it like a LAN, but wireless for all of us. Our squad channels are coming back.",
          "duration": 5.9350000000000005,
          "mode": "radio"
        },
        {
          "id": "SL2-04",
          "who": "COLE",
          "text": "You're a genius, Decker.",
          "duration": 4.6000000000000005,
          "mode": "radio"
        },
        {
          "id": "SL2-05",
          "who": "DECKER",
          "text": "Hey, I'm just telling you what I know from what we have left.",
          "duration": 4.633333333333334,
          "mode": "radio"
        },
        {
          "id": "SL2-06",
          "who": "DECKER",
          "text": "I'm raising your systems' heat levels. You should be able to toggle up to maximum efficiency.",
          "duration": 6.265000000000001,
          "mode": "heat"
        },
        {
          "id": "SL2-07",
          "who": "DECKER",
          "text": "You'll find an extra surprise for those icy units if they give you any trouble.",
          "duration": 5.495,
          "mode": "heat"
        },
        {
          "id": "SL2-08",
          "who": "DECKER",
          "text": "Get out of there. The ground is moving.",
