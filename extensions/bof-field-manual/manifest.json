{
  "manifest_version": 3,
  "name": "Bullets of Fury: Field Manual",
  "version": "1.1.0",
  "description": "Offline pilot dossiers, arsenal, boss tactics and your own field notes.",
  "icons": {
    "16": "art/icon16.png",
    "32": "art/icon32.png",
    "48": "art/icon48.png",
    "128": "art/icon128.png"
  },
  "action": {
    "default_title": "Open BOF Field Manual",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "art/icon16.png",
      "32": "art/icon32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}