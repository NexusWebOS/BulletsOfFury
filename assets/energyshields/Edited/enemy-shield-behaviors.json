{
  "format": "coleforge.enemy-defense-behaviors.v1",
  "asset": "Enemy Shield FX Volume 1",
  "target_viewport": [
    640,
    480
  ],
  "force_field_defaults": {
    "coverage": "omnidirectional",
    "energy_max": 100,
    "energy_regen_per_second": 7,
    "regen_delay_after_hit_ms": 900,
    "break_lockout_ms": 1400,
    "on_hit_animation": "impact",
    "on_break_animation": "overload",
    "draw_order": [
      "shield_back",
      "enemy",
      "shield_front",
      "impact_vfx"
    ]
  },
  "directional_deflector_defaults": {
    "coverage_arc_degrees": 110,
    "facing": "enemy_forward",
    "eligible_projectiles": [
      "bullets",
      "orbs",
      "small_lasers"
    ],
    "missiles": "detonate_on_contact_unless_enemy_override_allows_reflection",
    "beam_weapons": "block_damage_but_do_not reflect continuous beams",
    "reflection_speed_multiplier": 0.88,
    "reflection_formula": "v_reflected = v - 2 * dot(v, normal) * normal",
    "impact_cooldown_ms": 55,
    "on_deflect_animation": "deflect"
  },
  "families": [
    {
      "id": "ion-bubble",
      "type": "force_field",
