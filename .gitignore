# scratch and generated
_superseded/
*.zip
# staged hand-off drops for Mike's other PC are the one place a zip belongs in the repo (0912u)
!_STAGING/*.zip
node_modules/
__pycache__/
.DS_Store

# capture output — regenerate with shoot.py rather than committing pixels
_shots/
/tmp/

# art backups written by the one-off conversion scripts
*.bak

# dated art backups from the one-off conversion scripts (*.bak already covers the plain form)
*.bak-*

# video frame dumps from extract_playtest_frames_*.py — 147 MB for one session's recordings,
# and regenerable from Mike's own captures. The contact SHEETS are the useful output; the
# per-frame PNGs are not worth the repo.
docs/playtest_*/

# intermediate ship plates cut from the thruster pack by bake_pack_thrusters_0907p.py.
# 864 PNGs / 29 MB, and every one is reproducible in a single command from the sources in
# _ART_SOURCES_THRUSTERS, which ARE committed. The atlas built from them is what ships.
assets/game/ships_thrust/
assets/game/ships_sliced/

# API KEYS — NEVER COMMITTED
# _BUILD_SOURCE/.secrets.json holds the ElevenLabs key (and anything like it). It is read by
# _BUILD_SOURCE/elevenlabs.py at run time and must never enter the repo or a capture. If a key
# has ever been pasted into a chat, a log or a screenshot, rotate it - ignoring the file does
# not un-expose a key that has already been seen.
.secrets.json
_BUILD_SOURCE/.secrets.json
*.key

# marketing video masters and their scratch frames (docs/marketing_0916/, drop 0916).
# 767 MB of captured clips + 297 MB of rendered reels + 247 MB of extracted thumbnail frames.
# Every byte is REGENERABLE in one command from the shipped game -- capture_batch_0916.py for
# the clips, make_reel_0916.py / make_short_0916.py for the reels, make_thumbs_0916.py for the
# frames -- so putting 1.3 GB of h264 in the history buys nothing and costs every future clone.
# The PLAYBOOK, the channel art and the finished thumbnails are NOT ignored: those are the
# things actually uploaded, they are small, and a regenerated avatar that differs by a pixel
# from the one already on the channel is worse than a committed file.
docs/marketing_*/clips/
docs/marketing_*/video/
docs/marketing_*/social/thumbs/_frames/
